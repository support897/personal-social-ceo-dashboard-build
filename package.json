{
  "dependencies": {
    "@capacitor-firebase/authentication": "8.5.2",
    "@supabase/supabase-js": "^2.57.0",
    "firebase": "^13.0.0",
    "@revenuecat/purchases-capacitor": "^13.7.4"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.5.3",
    "@capacitor/core": "^8.5.3",
    "@capacitor/ios": "^8.5.3",
    "vite": "^6.3.5"
  },
  "name": "personal-social-ceo-dashboard",
  "private": true,
  "scripts": {
    "build": "vite build",
    "build:room": "vite build",
    "build:product": "PRODUCT_BUILD=1 vite build",
    "build:ceo": "CEO_BUILD=1 vite build && node arrange-ceo.mjs",
    "dev": "vite --host 0.0.0.0",
    "preview": "vite preview --host 0.0.0.0",
    "seed": "python3 scripts/build_seed.py",
    "build:pages": "npm run build:product && node arrange-web.mjs && node arrange-pages.mjs",
    "build:pages-ceo": "npm run build:ceo && node arrange-pages.mjs --ceo"
  },
  "type": "module",
  "version": "1.0.0"
}
